PORT=3000
HOST=0.0.0.0
# Virgulle ayrilmis origin listesi. Bos birakirsan default '*' kullanilir.
# Ornek: CORS_ORIGINS=http://localhost:3000,http://192.168.1.50:3000
CORS_ORIGINS=

# Kalici skor tablosu icin Postgres baglantisi.
# Bos birakilirsa in-memory fallback kullanilir.
DATABASE_URL=
DATABASE_SSL=true
